# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flemoji_db?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# AWS S3 (optional for later phases)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Stripe (optional for later phases)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Google OAuth Only
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── SEO / canonical URLs ─────────────────────────────────────────────────────
# The single source of truth for every canonical, og:url, robots.txt and
# sitemap entry (see src/lib/utils/site-url.ts). MUST be set in Vercel to the
# non-www form, otherwise canonicals can resolve to www.flemoji.com.
NEXT_PUBLIC_SITE_URL="https://flemoji.com"

# Google Search Console HTML-tag verification token — the value from the
# `content` attribute of the meta tag Search Console gives you (token only,
# not the whole tag). Leave empty to emit no verification tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── Analytics ────────────────────────────────────────────────────────────────
# GA4 measurement id. The tag only loads on the production deployment
# (NEXT_PUBLIC_VERCEL_ENV=production), so local and preview traffic never
# reaches the property. Override to point staging at a separate property.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-19MJR1SM8W"
